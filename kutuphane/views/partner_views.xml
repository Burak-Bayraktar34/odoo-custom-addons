<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_kutuphane" model="ir.ui.view">
        <field name="name">res.partner.form.kutuphane</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <field name="kutuphane_uyesi"/>
                <field name="uye_no" invisible="not kutuphane_uyesi"/>
            </xpath>
        </field>
    </record>
</odoo>